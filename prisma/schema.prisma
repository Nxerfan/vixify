// Vixify Prisma schema
// SQLite in sandbox; schema is Postgres-compatible for Supabase migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Core OTP request record. Codes are stored as HMAC-SHA256 hashes —
/// never plaintext. One row per /api/request-otp call.
model OtpRequest {
  id          String    @id @default(cuid())
  /// Normalized Iranian mobile: 09xxxxxxxxx (11 digits)
  phone       String
  /// HMAC-SHA256(code) using OTP_HASH_SECRET — never the raw code
  codeHash    String
  /// AES-256-GCM encrypted full SMS message text (for gateway delivery)
  messageEnc  String
  /// pending | sent | verified | expired | blocked
  status      String    @default("pending")
  /// Wrong-verify attempt counter
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  /// Set when the gateway picks up this OTP (dedup so it's never handed out twice)
  claimedAt   DateTime?
  /// Set when /api/v1/confirm-sent is called
  sentAt      DateTime?
  /// Set on successful verify
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  /// 2 minutes after createdAt
  expiresAt   DateTime
  /// True when generated under SANDBOX_MODE (no real SMS)
  sandbox     Boolean   @default(false)

  @@index([phone, createdAt])
  @@index([status, claimedAt])
}
